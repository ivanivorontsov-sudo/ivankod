# Учёт расходов: добавить трату, посмотреть итог
пусть траты = []
пусть работает = истина
пока работает
    напиши "1 — добавить, 2 — итог, 0 — выход"
    пусть выбор_пункта = спроси("Пункт:")
    если выбор_пункта == ничего или выбор_пункта == "0" или выбор_пункта == "" то
        стоп
    конец
    если выбор_пункта == "1" то
        попробуй
            пусть сумма = число(спроси("Сумма:"))
            траты.добавь(сумма)
            напиши "Добавлено:", сумма
        если ошибка как е
            напиши "Это не число"
        конец
    иначе если выбор_пункта == "2" то
        пусть итог = 0
        для каждого т из траты
            итог += т
        конец
        напиши "Итого:", итог
    конец
конец
напиши "До встречи!"
