{
  "name": "ivancode",
  "version": "1.5.1",
  "description": "ИванКод — студия разработки с ИИ",
  "main": "app/main.js",
  "author": "Воронцов Иван Игоревич",
  "license": "SEE LICENSE IN LICENSE.txt",
  "productName": "ИванКод",
  "dependencies": {
    "resedit": "^2.0.3"
  },
  "scripts": {
    "start": "electron .",
    "check": "node -e \"for(const f of require('fs').readdirSync('app').filter(f=>f.endsWith('.js')))require('child_process').execFileSync(process.execPath,['--check','app/'+f])\"",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win --dir",
    "test": "node -e \"const fs=require('fs'),c=require('child_process');const f=fs.readdirSync('test').filter(x=>x.endsWith('.test.js')).map(x=>'test/'+x);c.execFileSync(process.execPath,['--test',...f],{stdio:'inherit'})\"",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.vorontsov.ivancode",
    "productName": "ИванКод",
    "executableName": "IvanCode",
    "copyright": "© 2026 Воронцов Иван Игоревич",
    "files": [
      "app/**",
      "package.json"
    ],
    "extraResources": [
      "LICENSE.txt",
      "THIRD-PARTY.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "sign": "build/sign.js",
      "extraResources": [
        {
          "from": "bin/ponyatny.exe",
          "to": "ponyatny/ponyatny.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IvanCode-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "IvanCode-Portable-${version}.exe"
    },
    "asarUnpack": [
      "app/decomp/ghidra/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "IvanCode-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "bin/ponyatny-linux",
          "to": "ponyatny/ponyatny-linux"
        }
      ],
      "maintainer": "Воронцов Иван Игоревич <ivanivorontsov-sudo@users.noreply.github.com>"
    },
    "deb": {
      "packageName": "ivancode"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "IvanCode-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "bin/ponyatny-macos",
          "to": "ponyatny/ponyatny-macos"
        }
      ]
    },
    "dmg": {
      "artifactName": "IvanCode-${version}-mac-${arch}.${ext}"
    }
  }
}
